# RLTX Populous Environment Configuration
# Copy this to .env and fill in your values

# ===================
# Required API Keys
# ===================

# Claude API for LLM-powered analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Exa API for real-time web research (https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# ===================
# Database Configuration
# ===================

# SQLite (default for local development)
DATABASE_URL=sqlite:///./rltx.db

# Supabase (optional - for production)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ===================
# Application Settings
# ===================

# Debug mode (true/false)
DEBUG=true

# Server port (Railway sets PORT automatically)
PORT=8000

# Environment (development/staging/production)
ENVIRONMENT=development

# ===================
# Feature Flags
# ===================

# Enable/disable live web research
ENABLE_WEB_RESEARCH=true

# Maximum number of agents per simulation
MAX_AGENTS=500

# Default Monte Carlo iterations
DEFAULT_MONTE_CARLO_RUNS=1000
